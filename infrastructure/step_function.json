{
  "Comment": "Video Semantic Search v2 - Configurable pipeline with Neptune, OpenSearch, and modular segmentation/detection",
  "StartAt": "Init Job",
  "States": {
    "Init Job": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${InitJobArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Parallel - Transcribe and Segmentation",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Parallel - Transcribe and Segmentation": {
      "Type": "Parallel",
      "Next": "Restructure Parallel Output",
      "Branches": [
        {
          "StartAt": "Check Transcription Enabled",
          "States": {
            "Check Transcription Enabled": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.config.transcription",
                  "BooleanEquals": true,
                  "Next": "Start Transcribe Task And Wait Callback"
                }
              ],
              "Default": "Skip Transcription"
            },
            "Start Transcribe Task And Wait Callback": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${TranscribeArn}",
                "Payload": {
                  "TaskToken.$": "$$.Task.Token",
                  "vssParams.$": "$"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "TimeoutSeconds": 600,
              "ResultPath": "$.TranscribeParams",
              "End": true
            },
            "Skip Transcription": {
              "Type": "Pass",
              "Result": {},
              "ResultPath": "$.TranscribeParams",
              "End": true
            }
          }
        },
        {
          "StartAt": "Check Segmentation Mode",
          "States": {
            "Check Segmentation Mode": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.config.segmentationMode",
                  "StringEquals": "shot",
                  "Next": "Start Rekognition Shot Detection Task And Wait Callback"
                },
                {
                  "Variable": "$.config.segmentationMode",
                  "StringEquals": "interval",
                  "Next": "Interval Segmentation"
                }
              ],
              "Default": "Start Rekognition Shot Detection Task And Wait Callback"
            },
            "Start Rekognition Shot Detection Task And Wait Callback": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${RekognitionShotDetectionArn}",
                "Payload": {
                  "TaskToken.$": "$$.Task.Token",
                  "vssParams.$": "$"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 6,
                  "BackoffRate": 2
                }
              ],
              "TimeoutSeconds": 3600,
              "ResultSelector": {
                "segments.$": "$.Shots"
              },
              "ResultPath": "$.SegmentationResult",
              "End": true
            },
            "Interval Segmentation": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${IntervalSegmentationArn}",
                "Payload.$": "$"
              },
              "ResultSelector": {
                "segments.$": "$.Payload.segments"
              },
              "ResultPath": "$.SegmentationResult",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Restructure Parallel Output": {
      "Type": "Pass",
      "Comment": "Combine parallel outputs: $[0] = transcribe branch, $[1] = segmentation branch. Restructure into a flat object for downstream states.",
      "Parameters": {
        "jobId.$": "$[1].jobId",
        "video_name.$": "$[1].video_name",
        "config.$": "$[1].config",
        "TranscribeParams.$": "$[0].TranscribeParams",
        "segments.$": "$[1].SegmentationResult.segments"
      },
      "Next": "Extract Frames"
    },

    "Extract Frames": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ExtractFramesArn}",
        "Payload": {
          "jobId.$": "$.jobId",
          "video_name.$": "$.video_name",
          "config.$": "$.config",
          "segments.$": "$.segments",
          "TranscribeParams.$": "$.TranscribeParams"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Celebrity and Face Detection Map",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Celebrity and Face Detection Map": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Check Face Processing Needed",
        "States": {
          "Check Face Processing Needed": {
            "Type": "Choice",
            "Choices": [
              {
                "Or": [
                  {
                    "Variable": "$.config.celebrityDetection",
                    "BooleanEquals": true
                  },
                  {
                    "Variable": "$.config.faceRecognition",
                    "BooleanEquals": true
                  }
                ],
                "Next": "Face and Celebrity Detection"
              }
            ],
            "Default": "Skip All Faces"
          },
          "Face and Celebrity Detection": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${RekognitionCelebrityDetectionArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "celebrityFaces.$": "$.Payload.celebrityFaces",
              "unrecognizedFaces.$": "$.Payload.unrecognizedFaces"
            },
            "ResultPath": "$.celebrityDetectionResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Face Collection"
          },
          "Face Collection": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${FaceCollectionArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "faces.$": "$.Payload.faces"
            },
            "ResultPath": "$.faceCollectionResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Prepare Detection Output"
          },
          "Skip All Faces": {
            "Type": "Pass",
            "Result": {
              "faces": []
            },
            "ResultPath": "$.faceCollectionResult",
            "Next": "Prepare Detection Output"
          },
          "Prepare Detection Output": {
            "Type": "Pass",
            "Parameters": {
              "jobId.$": "$.jobId",
              "video_name.$": "$.video_name",
              "shot_id.$": "$.shot_id",
              "shot_startTime.$": "$.shot_startTime",
              "shot_endTime.$": "$.shot_endTime",
              "frames.$": "$.frames",
              "composite_key.$": "$.composite_key",
              "clip_key.$": "$.clip_key",
              "faceCollectionResult.$": "$.faceCollectionResult"
            },
            "End": true
          }
        }
      },
      "ItemsPath": "$.segments",
      "ItemSelector": {
        "jobId.$": "$$.Map.Item.Value.jobId",
        "video_name.$": "$$.Map.Item.Value.video_name",
        "shot_id.$": "$$.Map.Item.Value.shot_id",
        "shot_startTime.$": "$$.Map.Item.Value.shot_startTime",
        "shot_endTime.$": "$$.Map.Item.Value.shot_endTime",
        "frames.$": "$$.Map.Item.Value.frames",
        "composite_key.$": "$$.Map.Item.Value.composite_key",
        "clip_key.$": "$$.Map.Item.Value.clip_key",
        "config.$": "$.config",
        "TranscribeParams.$": "$.TranscribeParams",
        "segmentIndex.$": "$$.Map.Item.Index"
      },
      "MaxConcurrency": 10,
      "Label": "CelebrityFaceDetection",
      "ToleratedFailurePercentage": 2,
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "${ResultWriterBucket}",
          "Prefix": "sfn-results/detection"
        }
      },
      "ResultPath": "$.detectionResults",
      "Next": "Consolidate Detection Results",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Consolidate Detection Results": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ConsolidateMapResultsArn}",
        "Payload": {
          "resultWriterDetails.$": "$.detectionResults.ResultWriterDetails"
        }
      },
      "ResultSelector": {
        "consolidatedBucket.$": "$.Payload.consolidatedBucket",
        "consolidatedKey.$": "$.Payload.consolidatedKey"
      },
      "ResultPath": "$.consolidatedDetection",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Description Generation Map",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Description Generation Map": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Generate Shot Description",
        "States": {
          "Generate Shot Description": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${GenerateShotDescArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 15,
                "MaxAttempts": 20,
                "BackoffRate": 1
              }
            ],
            "End": true
          }
        }
      },
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.consolidatedDetection.consolidatedBucket",
          "Key.$": "$.consolidatedDetection.consolidatedKey"
        }
      },
      "ItemSelector": {
        "jobId.$": "$$.Map.Item.Value.jobId",
        "video_name.$": "$$.Map.Item.Value.video_name",
        "shot_id.$": "$$.Map.Item.Value.shot_id",
        "shot_startTime.$": "$$.Map.Item.Value.shot_startTime",
        "shot_endTime.$": "$$.Map.Item.Value.shot_endTime",
        "frames.$": "$$.Map.Item.Value.frames",
        "composite_key.$": "$$.Map.Item.Value.composite_key",
        "clip_key.$": "$$.Map.Item.Value.clip_key",
        "faces.$": "$$.Map.Item.Value.faceCollectionResult.faces"
      },
      "MaxConcurrency": 10,
      "Label": "DescriptionGeneration",
      "ToleratedFailurePercentage": 2,
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "${ResultWriterBucket}",
          "Prefix": "sfn-results/description"
        }
      },
      "ResultPath": "$.descriptionResults",
      "Next": "Consolidate Description Results",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Consolidate Description Results": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ConsolidateMapResultsArn}",
        "Payload": {
          "resultWriterDetails.$": "$.descriptionResults.ResultWriterDetails"
        }
      },
      "ResultSelector": {
        "consolidatedBucket.$": "$.Payload.consolidatedBucket",
        "consolidatedKey.$": "$.Payload.consolidatedKey"
      },
      "ResultPath": "$.consolidatedDescription",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Ingestion Map",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Ingestion Map": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Ingest Data",
        "States": {
          "Ingest Data": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${IngestDataArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.consolidatedDescription.consolidatedBucket",
          "Key.$": "$.consolidatedDescription.consolidatedKey"
        }
      },
      "ItemSelector": {
        "jobId.$": "$$.Map.Item.Value.jobId",
        "video_name.$": "$$.Map.Item.Value.video_name",
        "shot_id.$": "$$.Map.Item.Value.shot_id",
        "shot_startTime.$": "$$.Map.Item.Value.shot_startTime",
        "shot_endTime.$": "$$.Map.Item.Value.shot_endTime",
        "frames.$": "$$.Map.Item.Value.frames",
        "composite_key.$": "$$.Map.Item.Value.composite_key",
        "clip_key.$": "$$.Map.Item.Value.clip_key",
        "faces.$": "$$.Map.Item.Value.faces",
        "shot_description.$": "$$.Map.Item.Value.shot_description",
        "shot_transcript.$": "$$.Map.Item.Value.shot_transcript"
      },
      "MaxConcurrency": 10,
      "Label": "Ingestion",
      "ToleratedFailurePercentage": 2,
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "${ResultWriterBucket}",
          "Prefix": "sfn-results/ingestion"
        }
      },
      "ResultPath": "$.ingestionResults",
      "Next": "Finalize Job",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Finalize Job": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${FinalizeJobArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Success",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failed Task",
          "ResultPath": "$.error"
        }
      ]
    },

    "Notify Failed Task": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "${FailedJobArn}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Fail"
    },

    "Fail": {
      "Type": "Fail"
    },

    "Success": {
      "Type": "Succeed"
    }
  }
}
